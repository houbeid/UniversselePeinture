<Page x:Class="WPFModernVerticalMenu.Pages.SFacture"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFModernVerticalMenu.Pages" xmlns:xctk1="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SFacture">

    <Page.Resources>
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="border" BorderBrush="Gray" BorderThickness="0,0,0,3" Background="{TemplateBinding Background}">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#124481"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" VerticalAlignment="Top" Margin="5,0,0,20">
                <TextBlock Text="Suivi De Factures" FontSize="24" FontWeight="Bold" Foreground="#124481"/>
            </StackPanel>
            <!-- Left Navigation Panel -->
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="Date*" Margin="10" Padding="5" />
                    <xctk1:DatePicker Name="Date" Padding="5" HorizontalAlignment="Left" SelectedDateChanged="Date_SelectedDateChanged"/>
                </StackPanel>
                <TextBlock Text="Code Client*" Margin="10" Padding="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="CodeClientBox" Margin="10"  Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>
                <Label Content="Numero Facture*" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="NumFactTextBox" Margin="10"  Padding="10" Style="{StaticResource CustomTextBoxStyle}" />
                <TextBlock Text="Produit 1*" Margin="10" Padding="5"/>
                <ComboBox Name="Prod1" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <TextBlock Text="Quantité 1*" Margin="10,10,9.6,10" Padding="5"/>
                <TextBox Name="QtP1" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>

                <TextBlock Text="Produit 2" Margin="10" Padding="5"/>
                <ComboBox Name="Prod2" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <TextBlock Text="Quantité 2" Margin="10,10,9.6,10" Padding="5"/>
                <TextBox Name="QtP2" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>
            </StackPanel>

            <!-- Right Form Panel -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,30,30">
                <Label Content="Produit 3" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="Prod3" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <Label Content="Quantité 3" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="QtP3" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>

                <Label Content="Produit 4" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="Prod4" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <Label Content="Quantité 4" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="QtP4" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>

                <Label Content="Produit 5" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="Prod5" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <Label Content="Quantité 5" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="QtP5" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>

                <Label Content="Produit 6" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="Prod6" Margin="10" Padding="10" DisplayMemberPath="Name" />
                <Label Content="Quantité 6" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="QtP6" Margin="10" Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>
                <Label Content="Montant*" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="MontantTextBox" Margin="10"  Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>
                <Label Content="Distributeur" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="DistrubuteurTextBox" Margin="10"  Padding="10" Style="{StaticResource CustomTextBoxStyle}"/>
                <Button Content="Enregistrer" Click="EnregistrerFact_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,20,20" Padding="10,5" Background="#124481" Foreground="White" Width="376" Height="56"/>
            </StackPanel>
            <Button Content="Générer le suivi de Factures"  Click="SuiviFact_Click"  HorizontalAlignment="Center"  VerticalAlignment="Center"  Margin="10"  Padding="10,5"  Background="#124481"  Foreground="White"  Width="376"  Height="56"  Grid.Row="2" Grid.ColumnSpan="2"/>
            <Popup Name="PdfPopup" StaysOpen="False" Placement="Center" IsOpen="{Binding IsPopupOpen}">
                <Border Background="White" BorderBrush="#5f7fa1" BorderThickness="3" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <WebBrowser Name="PdfViewer" Width="800" Height="450"/>
                        <Button Background="#124481" Content="Télécharger" Click="DownloadButton_Click" Margin="10" VerticalAlignment="Center" Command="{Binding DownloadCommand}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </ScrollViewer>
</Page>